# DayOne Pages — delivery server
# Copy to server/.env (outside the webroot; only public/ is served).

# Supabase project. Only the PUBLISHABLE (anon) key — the service key never comes here.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# This server's key. Generate it with `openssl rand -hex 32` and register the
# hash in pages.server_keys (see README). Without it the RPC answers 403.
PAGES_SERVER_KEY=

# Marker returned by /_health (X-DayOne-Pages header). Same as the dashboard's
# SERVER_ID. E.g.: openssl rand -hex 8
SERVER_ID=

# Token for POST /_purge (X-Purge-Token header). Empty = purge disabled.
PURGE_TOKEN=

# Disk cache. The php-fpm user must be able to write here.
CACHE_DIR=/var/cache/dayone-pages

# TTLs in seconds.
CACHE_TTL=30           # routes + content (30 seconds)
NEGATIVE_TTL=30        # unknown or paused domain
STALE_MAX_AGE=604800   # how long an expired copy still serves if Supabase goes down (7 days)

# Stale-while-revalidate: 1 = serve the expired copy and refresh after the response (php-fpm only).
SWR=0

# Limits.
MAX_PATH_LEN=200
MAX_PATHS_PER_HOST=2000
SUPABASE_TIMEOUT=5

# 1 = send the X-Cache header (HIT/MISS/STALE/UPDATING). Useful for diagnostics.
DEBUG_HEADERS=1

# Traffic log: 1 = store one hit per request (host, path, outcome, country,
# device, bot, referrer, IP and User-Agent) in the pages.hits table, feeding the
# dashboard. Runs AFTER the response (doesn't delay the visitor). IP/UA are PII.
LOG_HITS=1
HITS_TIMEOUT=5         # timeout (s) of the log call; a failure only goes to the log

# Entry via www.: 302 to the domain without www; with sub1/utm_campaign/campaign
# in the URL, it gets ?sub0=<unix timestamp encrypted with AES-256-GCM, key
# SHA-256 of this value>. Empty = 'DAYONE'.
SUB0_KEY=DAYONE
