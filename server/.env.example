# DayOne Pages — servidor de entrega
# Copie para server/.env (fora do webroot; só public/ é servido).

# Projeto Supabase. Só a chave PUBLICÁVEL (anon) — a de serviço nunca vem para cá.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Chave deste servidor. Gere com `openssl rand -hex 32` e registre o hash em
# pages.server_keys (ver README). Sem ela a RPC responde 403.
PAGES_SERVER_KEY=

# Marcador devolvido em /_health (header X-DayOne-Pages). Igual ao SERVER_ID
# do dashboard. Ex.: openssl rand -hex 8
SERVER_ID=

# Token do POST /_purge (header X-Purge-Token). Vazio = purge desligado.
PURGE_TOKEN=

# Cache em disco. O usuário do php-fpm precisa escrever aqui.
CACHE_DIR=/var/cache/dayone-pages

# TTLs em segundos.
CACHE_TTL=300          # rotas + conteúdo (o "5 minutos")
NEGATIVE_TTL=300       # domínio desconhecido
STALE_MAX_AGE=604800   # por quanto tempo uma cópia expirada ainda serve se o Supabase cair (7 dias)

# Stale-while-revalidate: 1 = serve a cópia expirada e atualiza depois da resposta (só php-fpm).
SWR=0

# Limites.
MAX_PATH_LEN=200
MAX_PATHS_PER_HOST=2000
SUPABASE_TIMEOUT=5

# 1 = manda o header X-Cache (HIT/MISS/STALE/UPDATING). Útil em diagnóstico.
DEBUG_HEADERS=1

# Registro de tráfego: 1 = grava um hit por request (host, path, outcome, país,
# device, bot, referrer, IP e User-Agent) na tabela pages.hits, alimentando o
# dashboard. Vai DEPOIS da resposta (não atrasa o visitante). IP/UA são PII.
LOG_HITS=1
HITS_TIMEOUT=3         # timeout (s) da chamada de log; falha vai só para o log
