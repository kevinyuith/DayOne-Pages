# DayOne Pages — dashboard
# Copie para .env.local. Nenhuma destas variáveis vai para o repositório.

# Projeto Supabase (o schema `pages` vive nele).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave de SERVIÇO. Só o servidor lê (sem NEXT_PUBLIC_). Atravessa a RLS:
# a defesa do dashboard é o cookie de sessão, não o banco.
SUPABASE_SERVICE_KEY=

# Senha única do dashboard, como hash scrypt. Gere com `npm run hash-password`.
# Formato: scrypt.<N>.<r>.<p>.<sal>.<hash> — com PONTOS (o `$` seria comido
# pela expansão de variável do .env).
DASH_PASSWORD_HASH=

# Segredo que assina o cookie de sessão. Mínimo 16 caracteres; use 32+.
# Ex.: openssl rand -hex 32
DASH_SESSION_SECRET=

# IP público do servidor de entrega. Aparece nas instruções de DNS.
SERVER_IP=

# Marcador que o servidor devolve em /_health (header X-DayOne-Pages). Tem de
# ser IGUAL ao SERVER_ID do server/.env. É como o dashboard confirma que um
# domínio chegou no nosso servidor.
SERVER_ID=

# Opcional: URL direta do servidor (ex.: https://origin.seudominio.com), para
# diagnóstico e, na fase 2, purge instantâneo.
ORIGIN_URL=
